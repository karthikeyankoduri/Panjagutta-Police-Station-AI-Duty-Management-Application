# ─────────────────────────────────────────────────────────────────────────────
# PANJAGUTTA DUTY MANAGEMENT – Backend Environment Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_ENV=development                   # development | production
APP_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS
APP_DEBUG=true

# Database – PostgreSQL
DATABASE_URL=postgresql+asyncpg://panjagutta_user:CHANGE_PASSWORD@localhost:5432/panjagutta_duty

# JWT
JWT_SECRET_KEY=CHANGE_ME_ANOTHER_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth – security settings
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_INACTIVITY_TIMEOUT_MINUTES=60

# Demo seed flag – set to false in production to disable demo accounts
SEED_DEMO_DATA=true
DEMO_POLICY_ENABLED=true

# AI Provider (default: none – configure only with dept-approved model)
AI_PROVIDER=none                      # none | openai | local
AI_API_KEY=NOT_SET
AI_BASE_URL=http://localhost:11434    # if using local/on-prem model

# Reports
REPORTS_DIR=./generated_reports

# CORS – update to your frontend origin in production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY WARNING
# Default demo accounts are NOT production-safe.
# Run python -m app.db.seed --reset to regenerate with new passwords.
# Disable SEED_DEMO_DATA and DEMO_POLICY_ENABLED before production deployment.
# ─────────────────────────────────────────────────────────────────────────────
