# ─────────────────────────────────────────────────────────────────────────────
# docker compose settings — copy to .env and set every value marked CHANGE.
# Generate secrets with:  openssl rand -base64 48
# Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_USER=panjagutta
POSTGRES_PASSWORD=CHANGE_to_a_long_random_password
POSTGRES_DB=panjagutta_duty_db

# Must be at least 32 random characters; the API refuses to start in production otherwise.
JWT_SECRET_KEY=CHANGE_to_a_random_value_of_at_least_48_characters
APP_SECRET_KEY=CHANGE_to_another_random_value

APP_ENV=production
SEED_DEMO_DATA=false
AUTH_INACTIVITY_TIMEOUT_MINUTES=30
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# The address users type in the browser (used for CORS)
PUBLIC_ORIGIN=https://panjagutta-duty.local
HTTP_PORT=80
HTTPS_PORT=443

# Encrypted backups (scripts/backup.sh) — keep this passphrase offline as well
BACKUP_PASSPHRASE=CHANGE_to_a_strong_passphrase
BACKUP_DIR=./backups
